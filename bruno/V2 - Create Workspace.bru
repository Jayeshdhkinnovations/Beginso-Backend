meta {
  name: V2 - Create Workspace
  type: http
  seq: 103
}

post {
  url: {{base_url}}/api/workspaces
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Bruno Test",
    "slug": "bruno-test-{{$timestamp}}",
    "timezone": "UTC"
  }
}

assert {
  res.status: eq 201
  res.body.workspace.slug: isString
}

docs {
  Lazy creation: the only way a workspace comes into being.
}
