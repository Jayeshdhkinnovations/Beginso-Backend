meta {
  name: V2 - Transfer Ownership
  type: http
  seq: 130
}

post {
  url: {{base_url}}/api/workspaces/{{workspaceId}}/transfer-ownership
  body: json
  auth: inherit
}

headers {
  x-workspace-id: {{workspaceId}}
}

body:json {
  {
    "userId": "{{targetUserId}}"
  }
}

assert {
  res.status: eq 404
}

docs {
  Owner only. Runs after "Remove Member" (seq 109) has already removed {{targetUserId}} from this
  workspace, so the correct outcome here is 404 ("must already be a member") — this row exercises
  that guard, not the success path. To see transfer succeed, run it against a still-current member,
  e.g. re-invite {{targetUserId}} first, or duplicate this request earlier in the sequence.
}
