meta {
  name: V2 - Preview Invitation
  type: http
  seq: 114
}

get {
  url: {{base_url}}/api/invitations/{{invitationToken2}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.invitation.workspaceName: isString
}

docs {
  Public. Token from the invitation email. Uses invitationToken2 (untouched by resend/revoke),
  since Accept below (same invitation) still needs it pending.
}
