meta {
  name: V2 - Create Stage
  type: http
  seq: 201
}

post {
  url: {{base_url}}/api/workspaces/{{workspaceId}}/stages
  body: json
  auth: inherit
}

headers {
  x-workspace-id: {{workspaceId}}
}

body:json {
  {
    "name": "In Review",
    "colour": "#7C3AED",
    "category": "in_progress"
  }
}

assert {
  res.status: eq 201
  res.body.stage.name: eq In Review
}
