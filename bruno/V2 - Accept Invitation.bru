meta {
  name: V2 - Accept Invitation
  type: http
  seq: 115
}

post {
  url: {{base_url}}/api/invitations/{{invitationToken2}}/accept
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{inviteeToken}}
}

assert {
  res.status: eq 200
  res.body.workspace.slug: isString
}

docs {
  Caller's email must match the invitation, so this overrides the collection's default owner token
  with inviteeToken (the seeded user whose email matches invitationToken2's invitee).
}
