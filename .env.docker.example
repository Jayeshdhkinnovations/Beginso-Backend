# Used by `docker compose up --build` (docker-compose.yml): local development and QA only. Placeholders, no real credential.
# Copy to .env.docker if you want to change anything; the compose file has working defaults for everything below.
HOST_PORT=5000
JWT_SECRET=local-dev-only-change-me
PROXY_SHARED_SECRET=local-dev-only-change-me-too
APP_URL=http://localhost:3000
