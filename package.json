{
  "name": "beginso-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc && node copyAssets.js",
    "start": "node dist/server.js",
    "test": "jest --maxWorkers=4",
    "test:handles": "jest --runInBand --detectOpenHandles",
    "type-check": "tsc --noEmit",
    "migrate:v1": "ts-node src/scripts/migrateV1ToMemberships.ts",
    "migrate:theme": "ts-node src/scripts/migrateUserTheme.ts",
    "backfill:search": "ts-node src/scripts/backfillResponseSearchText.ts",
    "seed:templates": "ts-node src/scripts/seedTemplates.ts",
    "seed:form": "ts-node src/scripts/seedFullForm.ts",
    "seed:superadmin": "ts-node src/scripts/seedSuperAdmin.ts",
    "seed:user-responses": "ts-node src/scripts/seedUserResponses.ts",
    "seed:pitch-template": "ts-node src/scripts/seedPitchTemplate.ts"
  },
  "dependencies": {
    "@types/pdfkit": "^0.17.6",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.3",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.3.8",
    "nodemailer": "^9.0.4",
    "pdfkit": "^0.19.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^26.0.1",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "@usebruno/cli": "^3.5.1",
    "fast-check": "^4.8.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
