PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/onboarding
JWT_SECRET=your_jwt_secret_key_here
SUPER_ADMIN_EMAILS=superadmin@example.com
SUPER_ADMIN_PASSWORD=your_super_admin_password_here

# SMTP Mail Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM_NAME="Onboarding Platform"
SMTP_FROM_EMAIL=noreply@example.com
# CDN logo. Must resolve to a PNG (an .svg value is mapped to .png; mail clients cannot render SVG).
EMAIL_LOGO_URL=https://storage.beginso.com/assets/logo-full-light.png

# --- Added 28 Sep 2026 (security hardening) ---
# Number of reverse proxies in front of Node: nginx = 1, Cloudflare + nginx = 2, none = 0.
# A wrong value makes the client IP forgeable.
TRUST_PROXY_HOPS=1
# Must equal BACKEND_PROXY_SECRET on the frontend host. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROXY_SHARED_SECRET=change_me_long_random_value
# Extra allowed browser origins (comma separated), e.g. a staging frontend. Empty = only the built-in list.
CORS_ORIGINS=
# Set to false ONLY if the mail relay uses a self-signed certificate.
SMTP_TLS_REJECT_UNAUTHORIZED=true
# Public form ceilings (defaults shown)
MAX_UPLOAD_MB=25
MAX_UPLOAD_FILES=10
MAX_ANSWERS_BYTES=1048576
# IPs that are never rate limited (office / test machine), comma separated.
RATE_LIMIT_ALLOWLIST=
