PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/onboarding
JWT_SECRET=your_jwt_secret_key_here
SUPER_ADMIN_EMAILS=superadmin@example.com
SUPER_ADMIN_PASSWORD=your_super_admin_password_here

# SMTP Mail Settings
SMTP_HOST=your_smtp_host
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME="Beginso"
SMTP_FROM_EMAIL=no-reply@beginso.com
SMTP_FROM_EMAIL_NOTIFICATIONS=notifications@beginso.com
SMTP_FROM_EMAIL_SUPPORT=support@beginso.com
SMTP_REPLY_TO=no-reply@beginso.com

# Firebase Web Client Config
TRUST_PROXY_HOPS=1
PROXY_SHARED_SECRET=change_me_long_random_value
CORS_ORIGINS=
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Proxy and Rate Limiting Config
MAX_UPLOAD_MB=25
MAX_UPLOAD_FILES=10
MAX_ANSWERS_BYTES=1048576

RATE_LIMIT_ALLOWLIST=
APP_URL=https://example.invalid
