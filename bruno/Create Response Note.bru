meta {
  name: Create Response Note
  type: http
  seq: 241
}

post {
  url: {{base_url}}/api/responses/{{responseId}}/notes
  body: json
  auth: inherit
}

body:json {
  {
    "body": "Looks good to me, cc @teammate",
    "mentionIds": ["{{targetUserId}}"]
  }
}

assert {
  res.status: eq 201
  res.body.note.editedAt: isNull
}
