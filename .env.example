PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/onboarding
JWT_SECRET=your_jwt_secret_key_here
SUPER_ADMIN_EMAILS=superadmin@example.com
SUPER_ADMIN_PASSWORD=your_super_admin_password_here

# SMTP Mail Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM_NAME="Onboarding Platform"
SMTP_FROM_EMAIL=noreply@example.com
EMAIL_LOGO_URL=https://storage.beginso.com/assets/logo-full-light.svg
